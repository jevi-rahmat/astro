---
import PostCard from "../../components/PostCard.astro";
import MainLayout from "../../layouts/MainLayout.astro";

const allPosts = Object.values(import.meta.glob('./*.md', {eager: true}));
---

<MainLayout title="Deep-Sky">
    <h1>Blog</h1>

    <section class="container" aria-label="Latest">
        <div class="post-container">
            {
                allPosts.map((post: any) => <PostCard frontmatter={post.frontmatter} url={post.url} tagType="h2" />)
            }
        </div>
    </section>

</MainLayout>
